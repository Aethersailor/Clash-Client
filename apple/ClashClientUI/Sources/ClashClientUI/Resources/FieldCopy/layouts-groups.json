{
  "layouts": {
    "proxy-groups[select]": [
      {
        "id": "basic",
        "title": {
          "en": "Basics",
          "zh-Hans": "基本",
          "zh-Hant": "基本"
        },
        "footer": {
          "en": "You pick one node by hand; every connection in the group uses it.",
          "zh-Hans": "由你手动选一个节点，组里的连接都走它。",
          "zh-Hant": "由你手動選一個節點，組裡的連線都走它。"
        },
        "keys": [
          "name",
          "type",
          "default-selected"
        ]
      },
      {
        "id": "members",
        "title": {
          "en": "Members",
          "zh-Hans": "成员",
          "zh-Hant": "成員"
        },
        "footer": {
          "en": "Which nodes the group holds: picked by hand, taken from node sets, or matched by name.",
          "zh-Hans": "组里有哪些节点：手动挑选、引用节点集合，或按名字筛选。",
          "zh-Hant": "組裡有哪些節點：手動挑選、引用節點集合，或按名稱篩選。"
        },
        "keys": [
          "proxies",
          "use",
          "include-all",
          "include-all-proxies",
          "include-all-providers",
          "filter",
          "exclude-filter",
          "exclude-type",
          "empty-fallback"
        ]
      },
      {
        "id": "health",
        "title": {
          "en": "Health Check",
          "zh-Hans": "健康检查",
          "zh-Hant": "健康檢查"
        },
        "footer": {
          "en": "Tests only show each node's delay and never switch the node; they run on a schedule only when an interval is written.",
          "zh-Hans": "测速只用来显示延迟，不会替你换节点；写了间隔才会定时测。",
          "zh-Hant": "測速只用來顯示延遲，不會替你換節點；寫了間隔才會定時測。"
        },
        "keys": [
          "url",
          "interval",
          "timeout",
          "lazy",
          "expected-status",
          "max-failed-times"
        ]
      },
      {
        "id": "display",
        "title": {
          "en": "Display",
          "zh-Hans": "显示",
          "zh-Hant": "顯示"
        },
        "footer": {
          "en": "Only changes how the group shows in lists and dashboards.",
          "zh-Hans": "只影响列表和面板里怎么显示这个组。",
          "zh-Hant": "只影響列表和面板裡怎麼顯示這個組。"
        },
        "keys": [
          "hidden",
          "icon"
        ]
      },
      {
        "id": "more",
        "title": {
          "en": "More Settings",
          "zh-Hans": "更多设置",
          "zh-Hant": "更多設定"
        },
        "keys": [
          "*"
        ]
      }
    ],

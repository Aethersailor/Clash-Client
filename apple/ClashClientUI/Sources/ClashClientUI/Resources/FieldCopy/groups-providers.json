  "proxy-groups": {
    "summary": {
      "en": "Put nodes into groups used by manual choice, speed tests or failover.",
      "zh-Hans": "把节点分组，按手动选择、自动测速或故障转移使用。",
      "zh-Hant": "把節點分組，依手動選擇、自動測速或故障轉移使用。"
